# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.onrender.com

# Database (PostgreSQL - Neon)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host.c-5.us-east-1.aws.neon.tech
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.onrender.com,http://localhost:3000

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here

# IA Microservice
AI_MICROSERVICE_URL=http://localhost:8002

# Blockchain (Polygon Amoy Testnet)
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_smart_contract_address
BLOCKCHAIN_PRIVATE_KEY=your_server_wallet_private_key_here
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
